# evalkit reads these from your environment. Never commit real keys.
# Ollama (the default) needs no key.

# Only for hosted OpenAI-compatible servers (Groq, OpenRouter, ...), used with --base-url.
OPENAI_API_KEY=

# Only for Claude models (--model / --judge anthropic:...). Paid: evalkit shows a cost
# estimate and needs --yes before spending. Install with: pip install 'evalkit[anthropic]'
ANTHROPIC_API_KEY=
